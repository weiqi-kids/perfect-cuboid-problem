p=3: squares (nonzero) = [1]
        nonsquares = [2]
        chi(-1) = -1  (== 1 iff p == 1 mod 4)
        chi(2) = -1
        chi(5) = -1
p=5: squares (nonzero) = [1, 4]
        nonsquares = [2, 3]
        chi(-1) = 1  (== 1 iff p == 1 mod 4)
        chi(2) = -1
        chi(5) = 0
