\\ FULL MASSIVE CERTIFICATION for 5 BEYOND-QC fibers

default(parisize, 14000000000);
default(realprecision, 40);

\\ STAGE A: Direct point search on E_PCP(q) integer model
direct_pcp_search_full(mm, nn, B) = {
  local(uu, vv, found, a, b, X, Y, rhs, ngood, idx);
  uu = 2*mm*nn;
  vv = mm^2 - nn^2;
  print("\n=========================================");
  print("STAGE A: Direct search (m,n)=(", mm, ",", nn, "), B=", B);
  print("  q=", vv, "/", uu);
  print("=========================================");
  found = List();
  ngood = 0;
  for(b = 1, sqrtint(B), for(a = -B, B,
    if(gcd(a, b) != 1, next);
    if(a == 0, next);
    rhs = a*(a + uu^2*b^2)*(a + vv^2*b^2);
    if(rhs < 0, next);
    if(issquare(rhs, &Y), ngood += 1;
      X = a/b^2;
      if(X == 0 || X == -uu^2 || X == -vv^2, next);
      listput(found, [X, Y/b^3]);
    );
  ));
  print("  Squares total: ", ngood, "  Non-torsion candidates: ", #found);
  for(idx = 1, #found, print("    P = ", found[idx]));
  return([ngood, found]);
};

\\ STAGE B: Box scan on a factor with known generators
enum_combos(E, gens, B) = {
  local(n_g, cnt, idx, kk, jj, coords, P, Q, found);
  n_g = #gens;
  if(n_g == 0, return(List()));
  cnt = (2*B+1)^n_g;
  found = List();
  for(idx = 0, cnt - 1,
    coords = vector(n_g);
    kk = idx;
    for(jj = 1, n_g, coords[jj] = (kk % (2*B+1)) - B; kk = kk \ (2*B+1));
    P = [0];
    for(jj = 1, n_g, if(coords[jj] != 0, Q = ellmul(E, gens[jj], coords[jj]); P = elladd(E, P, Q)));
    if(#P >= 2, listput(found, [coords, P]));
  );
  return(found);
};

\\ Process one fiber
process_one(mm, nn, B_direct, factor_data) = {
  local(ii, fname, coefs, gens, E, n_g, B_eff, pts, total_pts, sieve_primes, p, sz, idx, E_Hp_coefs, E_Hp_gens);
  print("\n\n##############################################################");
  print("# Processing fiber (m,n)=(", mm, ",", nn, ")");
  print("##############################################################");

  direct_pcp_search_full(mm, nn, B_direct);

  print("\n--- STAGE B: box scan on J(V_q) factors ---");
  total_pts = 0;
  for(ii = 1, #factor_data,
    fname = factor_data[ii][1];
    coefs = factor_data[ii][2];
    gens = factor_data[ii][3];
    if(#gens == 0, print("  E_", fname, ": no gens, skipped"); next);
    E = ellinit(coefs);
    n_g = #gens;
    B_eff = if(n_g == 1, 500, if(n_g == 2, 30, if(n_g == 3, 10, 6)));
    pts = enum_combos(E, gens, B_eff);
    total_pts += #pts;
    print("  E_", fname, ": rank=", n_g, " B=", B_eff, " #pts=", #pts);
  );
  print("  Total box-scan points: ", total_pts);

  print("\n--- STAGE C: MW sieve on E_Hp factor ---");
  E_Hp_coefs = 0; E_Hp_gens = List();
  for(ii = 1, #factor_data, if(factor_data[ii][1] == "Hp", E_Hp_coefs = factor_data[ii][2]; E_Hp_gens = factor_data[ii][3]));
  if(#E_Hp_gens > 0,
    sieve_primes = [13, 17, 29, 37, 41, 43, 47, 53, 59, 67];
    for(idx = 1, #sieve_primes,
      p = sieve_primes[idx];
      if(Mod(elldisc(ellinit(E_Hp_coefs)), p) == 0, print("  p=", p, ": bad reduction"); next);
      sz = ellcard(ellinit(E_Hp_coefs, p));
      print("  p=", p, " #E_Hp(F_p)=", sz, " factored=", factor(sz));
    );
  );
  return(1);
};

