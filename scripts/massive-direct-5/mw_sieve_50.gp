\\ ============================================================
\\ HARDENED Mordell-Weil sieve for 5 BEYOND-QC fibers
\\ Track B: 50 sieve primes, rigorous subgroup-order bound
\\ ============================================================
\\
\\ For each fiber V_q (Jacobian decomposed into elliptic factors)
\\ and each sieve prime p of good reduction across every factor:
\\
\\  (a) Compute #E_i(F_p) for each elliptic factor E_i
\\  (b) Reduce each global generator G_{i,j} mod p
\\      (skip a (prime, factor) if any generator hits infinity)
\\  (c) Compute the actual order |H_i(p)| of the subgroup of
\\      E_i(F_p) generated by the reductions, by direct
\\      enumeration (subgroup growth) -- not just LCM of orders.
\\  (d) Density d_i(p) = |H_i(p)| / #E_i(F_p),  product over factors.
\\
\\ Rigorous statement:
\\   image of MW(J(V_q)) in prod_i E_i(F_p)  has order  <=  prod_i |H_i(p)|.
\\
\\ Verification: the 8 known degenerate c=0 points of E_PCP(q) are
\\ 2-torsion images; we check that 2-torsion of each E_i is contained
\\ in H_i(p) only when expected (these come from torsion of J, not MW
\\ generators).  We instead verify the SUBGROUP H_i(p) contains the
\\ identity (trivial) and that each generator reduces to a point of
\\ correct order dividing #E_i(F_p) (Lagrange). The "8 degenerate
\\ points" of E_PCP itself sit inside torsion which is not part of
\\ the J(V_q) free MW we are sieving.
\\
\\ Coverage report: per fiber, log10(prod_p density_p) measures how
\\ much of MW phase space is excluded.

default(parisize, 500000000);   \\ 500 MB
default(realprecision, 28);

\\ ============================================================
\\ Helper: |<Q_1,...,Q_r>| inside E(F_p)
\\ Brute subgroup growth.  E(F_p) is small (|E| < 300 for p < 250).
\\ ============================================================

elem_eq(P, Q) = {
  if(P == [0], return(Q == [0]));
  if(Q == [0], return(0));
  return(P[1] == Q[1] && P[2] == Q[2]);
};

\\ Is point P in the list L?
in_list(L, P) = {
  my(k);
  for(k = 1, #L,
    if(elem_eq(L[k], P), return(1))
  );
  return(0);
};

\\ Subgroup <H, Q> in E given the existing list of points L = H.
\\ Returns the new (sorted) point list.
extend_subgroup(E, L, Q) = {
  my(newL, oQ, kk, h, Qk);
  \\ If Q already in L, no change.
  if(in_list(L, Q), return(L));
  oQ = ellorder(E, Q);
  if(oQ == 0, oQ = 1);  \\ shouldn't happen, but defensive
  newL = L;
  \\ For each existing h in L, add h + k*Q for k = 1..oQ-1
  \\ (k=0 already in L).
  \\ But also h + 0*Q = h is in L.
  \\ Simpler: form coset union, then dedupe.
  Qk = [0];
  for(kk = 1, oQ - 1,
    Qk = elladd(E, Qk, Q);
    for(h = 1, #L,
      my(s);
      s = elladd(E, L[h], Qk);
      if(!in_list(newL, s),
        newL = concat(newL, [s])
      )
    )
  );
  return(newL);
};

\\ Compute |<Q_1, ..., Q_r>| in E(F_p).
subgroup_order(E, gens_red) = {
  my(L, k);
  L = [[0]];   \\ start with identity
  for(k = 1, #gens_red,
    if(gens_red[k] === 0, next);   \\ marker: reduction at infty
    L = extend_subgroup(E, L, gens_red[k])
  );
  return(#L);
};

\\ ============================================================
\\ Reduce a rational point P=[x,y] modulo p.
\\ Returns 0 if any denominator is divisible by p (infinite reduction),
\\ else returns the reduced affine point [x mod p, y mod p].
\\ ============================================================
reduce_pt(P, p) = {
  my(dx, dy, nx, ny);
  dx = denominator(P[1]);
  dy = denominator(P[2]);
  if(dx % p == 0 || dy % p == 0, return(0));
  nx = (numerator(P[1]) * Mod(dx, p)^(-1));
  ny = (numerator(P[2]) * Mod(dy, p)^(-1));
  return([lift(nx) % p, lift(ny) % p]);
};

\\ ============================================================
\\ Main per-fiber routine.
\\ Returns vector of per-prime data:
\\   [p, total_subgroup_size, total_card, density]
\\ and detailed per-factor info printed.
\\ ============================================================

mw_sieve_fiber_hard(label, fiber_factors, candidate_primes) = {
  my(ii, fname, coefs, gens, E, EPp, disc, p, sz, ord, j, k);
  my(per_fiber_log_density, n_primes_used, total_product_bound);
  my(prime_entries, factor_skipped);

  print("\n========================================================");
  print("=== HARDENED MW SIEVE for fiber ", label, " ===");
  print("========================================================");

  \\ Pre-build E over Q for each factor, capture disc and torsion generators
  my(EQ, discs, torsgens);
  EQ = vector(#fiber_factors);
  discs = vector(#fiber_factors);
  torsgens = vector(#fiber_factors);
  for(ii = 1, #fiber_factors,
    EQ[ii] = ellinit(fiber_factors[ii][2]);
    discs[ii] = EQ[ii].disc;
    torsgens[ii] = elltors(EQ[ii])[3];   \\ list of torsion generators (vector of [x,y])
    print("  factor ", fiber_factors[ii][1], " torsion gens: ", torsgens[ii]);
  );

  \\ Filter primes: only those with good reduction for EVERY factor.
  my(valid_primes);
  valid_primes = [];
  for(j = 1, #candidate_primes,
    p = candidate_primes[j];
    my(ok);
    ok = 1;
    for(ii = 1, #fiber_factors,
      if(discs[ii] % p == 0, ok = 0; break)
    );
    if(ok, valid_primes = concat(valid_primes, [p]))
  );
  print("Candidate primes : ", candidate_primes);
  print("Valid (good red.): ", valid_primes, "  (", #valid_primes, " primes)");

  if(#valid_primes < 50,
    print("NOTE: only ", #valid_primes, " primes pass good-reduction filter.")
  );

  \\ Take first 50 valid primes
  my(used_primes);
  if(#valid_primes > 50,
    used_primes = vector(50, k, valid_primes[k]),
    used_primes = valid_primes
  );
  print("Using ", #used_primes, " primes: ", used_primes);

  prime_entries = vector(#used_primes);

  per_fiber_log_density = 0.0;
  total_product_bound = 1;  \\ product over primes of (subgroup-size bound), CRT-style upper bound

  for(j = 1, #used_primes,
    p = used_primes[j];
    my(prime_total_subgroup, prime_total_card);
    prime_total_subgroup = 1;
    prime_total_card = 1;
    print("\n--- p = ", p, " ---");
    for(ii = 1, #fiber_factors,
      fname = fiber_factors[ii][1];
      coefs = fiber_factors[ii][2];
      gens = fiber_factors[ii][3];
      EPp = ellinit(coefs, p);
      sz = ellcard(EPp);
      prime_total_card *= sz;

      if(#gens == 0,
        \\ no global generators known: the MW image in this factor
        \\ could be anything; conservative bound is full E(F_p).
        print("  E_", fname, ": #E(F_p)=", sz,
              " | no gens -> subgroup bound = #E(F_p)");
        prime_total_subgroup *= sz;
        next
      );

      \\ Reduce generators
      my(gens_red, orders, any_bad, n_good);
      gens_red = vector(#gens);
      orders = vector(#gens);
      any_bad = 0;
      n_good = 0;
      for(k = 1, #gens,
        my(rp);
        rp = reduce_pt(gens[k], p);
        if(rp === 0,
          any_bad = 1;
          gens_red[k] = 0;
          orders[k] = -1
        ,
          \\ sanity: check on curve mod p
          if(!ellisoncurve(EPp, rp),
            \\ this would indicate bad reduction not caught
            any_bad = 1;
            gens_red[k] = 0;
            orders[k] = -2
          ,
            gens_red[k] = rp;
            orders[k] = ellorder(EPp, rp);
            if(orders[k] == 0, orders[k] = 1);
            n_good += 1
          )
        )
      );

      \\ Also reduce torsion generators and add them to the subgroup
      \\ (the 8 degenerate c=0 points correspond to torsion images;
      \\ they belong to the MW image and must be sieved through).
      my(tgens_red, tg);
      tgens_red = vector(#torsgens[ii]);
      for(tg = 1, #torsgens[ii],
        my(rp);
        rp = reduce_pt(torsgens[ii][tg], p);
        if(rp === 0,
          tgens_red[tg] = 0
        ,
          if(!ellisoncurve(EPp, rp),
            tgens_red[tg] = 0
          ,
            tgens_red[tg] = rp
          )
        )
      );

      \\ Compute subgroup order via enumeration of <free gens, torsion gens>
      my(Hsz, all_red);
      all_red = concat(gens_red, tgens_red);
      Hsz = subgroup_order(EPp, all_red);

      \\ Verify torsion injects: ord(torsion gen) mod p should match its global order
      my(tors_inj);
      tors_inj = 1;
      for(tg = 1, #tgens_red,
        if(tgens_red[tg] === 0, tors_inj = 0; break);
        my(o);
        o = ellorder(EPp, tgens_red[tg]);
        if(o != 2,  \\ all torsion gens here are 2-torsion (Klein-four)
          tors_inj = 0; break
        )
      );

      prime_total_subgroup *= Hsz;

      print("  E_", fname, ": #E(F_p)=", sz,
            "  orders=", orders,
            "  |H|=", Hsz,
            "  |H|/#E=", Hsz*1.0/sz,
            "  tors_inj=", tors_inj,
            if(any_bad, " [some gens reduce to infty]", ""));
    );

    my(density);
    density = prime_total_subgroup * 1.0 / prime_total_card;
    print("  -> product over factors: |H_total|=", prime_total_subgroup,
          "  #J(F_p) ~ ", prime_total_card,
          "  density=", density);

    prime_entries[j] = [p, prime_total_subgroup, prime_total_card, density];
    per_fiber_log_density += log(density) / log(10);
    total_product_bound *= prime_total_subgroup;
  );

  print("\n=== Fiber ", label, " SUMMARY ===");
  print("Primes used               : ", #used_primes);
  print("Sum log10(density_p)      : ", per_fiber_log_density);
  print("Total subgroup-bound prod : ", total_product_bound);
  print("log10(total bound)        : ", log(total_product_bound*1.0)/log(10));
  print("log10(prod #E_p)          :", " (informational)");
  my(log_prod_card);
  log_prod_card = 0.0;
  for(j = 1, #used_primes, log_prod_card += log(prime_entries[j][3]*1.0)/log(10));
  print("log10(prod #J(F_p))       : ", log_prod_card);
  print("Sieve exclusion (log10)   : ", log_prod_card - log(total_product_bound*1.0)/log(10));

  return([label, prime_entries, per_fiber_log_density, total_product_bound]);
};

