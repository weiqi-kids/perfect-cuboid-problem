\\ ============================================================
\\ RUN
\\ ============================================================

R61 = mw_sieve_fiber_hard("(61,38)", fd_61_38, candidate_primes);
R63 = mw_sieve_fiber_hard("(63,38)", fd_63_38, candidate_primes);
R73 = mw_sieve_fiber_hard("(73,24)", fd_73_24, candidate_primes);
R88 = mw_sieve_fiber_hard("(88,35)", fd_88_35, candidate_primes);
R99 = mw_sieve_fiber_hard("(99,28)", fd_99_28, candidate_primes);

\\ ============================================================
\\ Final cross-fiber summary
\\ ============================================================

print("\n\n======================================================");
print("==     FINAL SUMMARY (50-prime hardened sieve)      ==");
print("======================================================");

{all_results = [R61, R63, R73, R88, R99];}
{for(i = 1, #all_results,
  print("Fiber ", all_results[i][1], "  sum log10(density) = ", all_results[i][3], "  total bound prod = ", all_results[i][4])
);}

print("\n=== DONE HARDENED MW SIEVE 50 ===");
quit;
