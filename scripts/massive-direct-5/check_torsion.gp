\\ Verify the rational torsion on each elliptic factor.
default(parisize, 500000000);

check_torsion(coefs, label) = {
  my(E, T);
  E = ellinit(coefs);
  T = elltors(E);
  print(label, " torsion: order=", T[1], " structure=", T[2], " gens=", T[3]);
};

print("=== Fiber (61,38) ===");
check_torsion([1, 0, 0, -42684740442159, -101889258036034244616], "E_ef");
check_torsion([0, 1, 0, -55728214538800, -146186146319718549100], "E_fg");
check_torsion([0, -1, 0, -125792010606624, -415427350830110490816], "E_Hp");

print("=== Fiber (63,38) ===");
check_torsion([1, 0, 0, -54426114516745, -149326661877655991488], "E_ef");
check_torsion([1, 0, 0, -224751480208975, -1296824565825870679168], "E_eg");
check_torsion([0, -1, 0, -140013601817920, -435817780667752184768], "E_Hp");

print("=== Fiber (73,24) ===");
check_torsion([1, 0, 0, -94673377998924, -353919433762272635136], "E_ef");
check_torsion([1, 0, 0, -153339850777260, -719732586296951884800], "E_eg");
check_torsion([0, -1, 0, -127910198192064, 83501181854697176064], "E_Hp");

print("=== Fiber (88,35) ===");
check_torsion([1, 0, 0, -537960923191390, -4802565205544754983500], "E_ef");
check_torsion([1, 1, 1, -1055111008889790, -13136825392429479796245], "E_eg");
check_torsion([0, -1, 0, -544435463254240, 4681038068313777913600], "E_Hp");

print("=== Fiber (99,28) ===");
check_torsion([1, 0, 0, -886286644253514, -10038599072058161134656], "E_ef");
check_torsion([1, 0, 0, -1285630732110690, -17118244345470634548000], "E_eg");
check_torsion([0, -1, 0, -3056260378721760, -65023932923994267595008], "E_fg");
check_torsion([0, -1, 0, -1685461832548704, -10854385900968766899456], "E_Hp");

quit;
