// Quadratic Chabauty Magma script for V_q at (m,n) = (97,90)
// Generated by gen_magma_script.gp
// q = 17460/1309
//   1 + q^2 = 17509^2 / 1309^2
// Total rank on J(V_q): [8,10]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1309 c, E = 1309 e, F = 1309 f, G = 1309 g:
//   E^2 = C^2 + 304851600
//   F^2 = C^2 + 1713481
//   G^2 = C^2 + 306565081
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 304851600,
    F^2 - C^2 - 1713481,
    G^2 - C^2 - 306565081
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -2088550791282745, 26674455180068699016800]);
// rank in [3,3]; conductor 4214272596765
E_eg := EllipticCurve([1, 0, 0, -31152346316016895, -2116334235050885049287200]);
// rank in [0,2]; conductor 33347553855
E_fg := EllipticCurve([0, -1, 0, -2111233189322320, 27161735418174823590400]);
// rank in [2,2]; conductor 533560861680
E_Hp := EllipticCurve([0, -1, 0, -30805025538425920, -2080817073360666565745600]);
// rank in [2,2]; conductor 67428361548240
E_Hm := EllipticCurve([1, 0, 0, -179928084875969977146250789122590, 928959003448315733548460420814856254439309916100]);
// rank in [1,1]; conductor 147575397793516770

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![123687440, 1288576779860],
    E_ef![4686701997665/4096, 10137988077222682865/262144],
    E_ef![579225347945477/4857616, 12993328360186818801193/10706185664]
];
gens_eg := [
];
gens_fg := [
    E_fg![19704195600/529, 172459381542560/12167],
    E_fg![3923141611285/103684, 1270857774941035875/33386248]
];
gens_Hp := [
    E_Hp![555858282, 12350877423698],
    E_Hp![2474637917529645/3034564, 119975583810748878539735/5286210488]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 17460, +- 1309, +- 17509)
b_pt := V![0, 17460, 1309, 17509];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
