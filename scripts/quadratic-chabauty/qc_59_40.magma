// Quadratic Chabauty Magma script for V_q at (m,n) = (59,40)
// Generated by gen_magma_script.gp
// q = 4720/1881
//   1 + q^2 = 5081^2 / 1881^2
// Total rank on J(V_q): [7,9]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1881 c, E = 1881 e, F = 1881 f, G = 1881 g:
//   E^2 = C^2 + 22278400
//   F^2 = C^2 + 3538161
//   G^2 = C^2 + 25816561
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 22278400,
    F^2 - C^2 - 3538161,
    G^2 - C^2 - 25816561
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -33591450294490, -64875752322045712300]);
// rank in [3,3]; conductor 6932576613270
E_eg := EllipticCurve([1, 1, 1, -191978028012090, -1023817940648451683145]);
// rank in [1,3]; conductor 1879614330
E_fg := EllipticCurve([0, 1, 0, -40787864481440, -82446476430365203212]);
// rank in [1,1]; conductor 15036914640
E_Hp := EllipticCurve([0, -1, 0, -143340374599840, -596236822466924038400]);
// rank in [2,2]; conductor 55460612906160
E_Hm := EllipticCurve([1, 0, 0, -5005916654676823897933059380, 136024365434041660318468578968803991648400]);
// rank in [0,0]; conductor 35224421772024870

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-435559630/169, 4704366758300/2197],
    E_ef![3040594766/25, 167462118541696/125],
    E_ef![-16701245/4, 12891174395/8]
];
gens_eg := [
    E_eg![275528305331311/7963684, 4128199134997856434825/22473516248]
];
gens_fg := [
    E_fg![69032160841/6400, 13857334683002811/512000]
];
gens_Hp := [
    E_Hp![59629042, 450416343762],
    E_Hp![14297392, 16642620288]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4720, +- 1881, +- 5081)
b_pt := V![0, 4720, 1881, 5081];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
