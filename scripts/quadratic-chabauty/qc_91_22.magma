// Quadratic Chabauty Magma script for V_q at (m,n) = (91,22)
// Generated by gen_magma_script.gp
// q = 4004/7797
//   1 + q^2 = 8765^2 / 7797^2
// Total rank on J(V_q): [6,10]
// Prime of good ordinary reduction: p = 17
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 7797 c, E = 7797 e, F = 7797 f, G = 7797 g:
//   E^2 = C^2 + 16032016
//   F^2 = C^2 + 60793209
//   G^2 = C^2 + 76825225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 16032016,
    F^2 - C^2 - 60793209,
    G^2 - C^2 - 76825225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -366620158101099, -2595060275698788626736]);
// rank in [3,3]; conductor 349352024842821
E_eg := EllipticCurve([1, 1, 1, -487550542561985, -3838680855546618175810]);
// rank in [1,3]; conductor 68409045705
E_fg := EllipticCurve([0, 1, 0, -1562172018653680, -23764257073364067659500]);
// rank in [0,2]; conductor 1094544731280
E_Hp := EllipticCurve([0, -1, 0, -992734032720864, -8628585259041440876736]);
// rank in [2,2]; conductor 5589632397485136
E_Hm := EllipticCurve([1, 0, 0, -266149719372437498088725668770, 51928184490092213345419093363369885805100612]);
// rank in [0,0]; conductor 6124140995494652130

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-5115312291264/403225, 968753992048053036/256047875],
    E_ef![19984626440604/196249, 87629876497620315054/86938307],
    E_ef![627172947788016/525625, 15704294553564945611136/381078125]
];
gens_eg := [
    E_eg![88304303334362991/2891212900, 15356977290366579775354051/155460517633000]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-13248016, 46882966856],
    E_Hp![2586624882681/1024, 4159740828728093427/32768]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4004, +- 7797, +- 8765)
b_pt := V![0, 4004, 7797, 8765];

// === Run QC ===
p := 17;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
