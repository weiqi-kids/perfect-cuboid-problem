// Quadratic Chabauty Magma script for V_q at (m,n) = (40,29)
// Generated by gen_magma_script.gp
// q = 2320/759
//   1 + q^2 = 2441^2 / 759^2
// Total rank on J(V_q): [7,9]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 759 c, E = 759 e, F = 759 f, G = 759 g:
//   E^2 = C^2 + 5382400
//   F^2 = C^2 + 576081
//   G^2 = C^2 + 5958481
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 5382400,
    F^2 - C^2 - 576081,
    G^2 - C^2 - 5958481
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -1514830756670, -524964685611415500]);
// rank in [3,3]; conductor 1057918875090
E_eg := EllipticCurve([1, 1, 1, -10697223322270, -13466484612926020405]);
// rank in [1,3]; conductor 537288510
E_fg := EllipticCurve([0, 1, 0, -1747735684320, -611647205914504332]);
// rank in [0,0]; conductor 4298308080
E_Hp := EllipticCurve([0, -1, 0, -8733800234720, -9511654106751033600]);
// rank in [1,1]; conductor 8463351000720
E_Hm := EllipticCurve([1, 0, 0, -17286875399641354115078140, 27652110209703789429569144495817347600]);
// rank in [2,2]; conductor 2582379974094690

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-143487210140/263169, 50349191257810990/135005697],
    E_ef![-27330390/49, 131349593010/343],
    E_ef![17916372, 75644366262]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![6021842, 12500491122]
];
gens_Hm := [
    E_Hm![5530429659762800606/2356225, 322079836899178658943487966/3616805375],
    E_Hm![514441931635769720/237169, 69374829104880918261713180/115501303]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 2320, +- 759, +- 2441)
b_pt := V![0, 2320, 759, 2441];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
