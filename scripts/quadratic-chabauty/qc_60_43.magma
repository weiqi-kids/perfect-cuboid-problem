// Quadratic Chabauty Magma script for V_q at (m,n) = (60,43)
// Generated by gen_magma_script.gp
// q = 5160/1751
//   1 + q^2 = 5449^2 / 1751^2
// Total rank on J(V_q): [5,11]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 11 = -2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1751 c, E = 1751 e, F = 1751 f, G = 1751 g:
//   E^2 = C^2 + 26625600
//   F^2 = C^2 + 3066001
//   G^2 = C^2 + 29691601
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 26625600,
    F^2 - C^2 - 3066001,
    G^2 - C^2 - 29691601
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -38775011763550, -70697527059279181600]);
// rank in [3,3]; conductor 53216186625210
E_eg := EllipticCurve([1, 0, 0, -263714738072950, -1648348032598704001600]);
// rank in [1,3]; conductor 12308146710
E_fg := EllipticCurve([0, -1, 0, -45114046439200, -83569053431488160000]);
// rank in [0,0]; conductor 98465173680
E_Hp := EllipticCurve([0, -1, 0, -212229607088800, -1131002820498655520000]);
// rank in [1,3]; conductor 425729493001680
E_Hm := EllipticCurve([1, 0, 0, -10333238661069434756784435500, 404056039048952318551937846032421060250000]);
// rank in [0,2]; conductor 289975000920769290

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-53802160400/20449, 10590956773873640/2924207],
    E_ef![-27886337640324248/7009205841, 2664250668768058468684436/586817722214361],
    E_ef![-866364984552060088/175101239401, 12427785372572442320681236/73271288728587851]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-249484715/36, 569219535955/216]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 5160, +- 1751, +- 5449)
b_pt := V![0, 5160, 1751, 5449];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
