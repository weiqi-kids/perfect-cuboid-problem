// Quadratic Chabauty Magma script for V_q at (m,n) = (61,38)
// Generated by gen_magma_script.gp
// q = 4636/2277
//   1 + q^2 = 5165^2 / 2277^2
// Total rank on J(V_q): [9,13]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 13 = -4

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 2277 c, E = 2277 e, F = 2277 f, G = 2277 g:
//   E^2 = C^2 + 21492496
//   F^2 = C^2 + 5184729
//   G^2 = C^2 + 26677225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 21492496,
    F^2 - C^2 - 5184729,
    G^2 - C^2 - 26677225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -42684740442159, -101889258036034244616]);
// rank in [3,3]; conductor 14345632782327
E_eg := EllipticCurve([1, 1, 1, -191680080009605, -1021412444307964638550]);
// rank in [1,3]; conductor 4543552365
E_fg := EllipticCurve([0, 1, 0, -55728214538800, -146186146319718549100]);
// rank in [2,2]; conductor 72696837840
E_Hp := EllipticCurve([0, -1, 0, -125792010606624, -415427350830110490816]);
// rank in [3,3]; conductor 229530124517232
E_Hm := EllipticCurve([1, 0, 0, -4201713691887954766021162410, 103564307677747011646913552825626935447972]);
// rank in [0,2]; conductor 148190386641437910

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![58987827/4, 397992407343/8],
    E_ef![592500852, 14421088318314],
    E_ef![44640322184/625, 9390298181935952/15625]
];
gens_eg := [
];
gens_fg := [
    E_fg![298156741903850/1713481, 5143525299205695602880/2242946629],
    E_fg![116218354628075/201601, 1252781991116084208780/90518849]
];
gens_Hp := [
    E_Hp![19412880, 66772174392],
    E_Hp![67728852906/5329, 2423087106159762/389017],
    E_Hp![366869435353/11881, 205346214100247220/1295029]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4636, +- 2277, +- 5165)
b_pt := V![0, 4636, 2277, 5165];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
