// Quadratic Chabauty Magma script for V_q at (m,n) = (84,37)
// Generated by gen_magma_script.gp
// q = 6216/5687
//   1 + q^2 = 8425^2 / 5687^2
// Total rank on J(V_q): [7,9]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 5687 c, E = 5687 e, F = 5687 f, G = 5687 g:
//   E^2 = C^2 + 38638656
//   F^2 = C^2 + 32341969
//   G^2 = C^2 + 70980625
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 38638656,
    F^2 - C^2 - 32341969,
    G^2 - C^2 - 70980625
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -417376077084054, -3281963281944052802976]);
// rank in [3,3]; conductor 219950942442
E_eg := EllipticCurve([1, 0, 0, -935990378988270, -11002155854028288033600]);
// rank in [1,3]; conductor 1353759330
E_fg := EllipticCurve([0, -1, 0, -796320760647840, -8606383853933649938688]);
// rank in [1,1]; conductor 10830074640
E_Hp := EllipticCurve([0, -1, 0, -429766160576544, 3076757020728299361024]);
// rank in [1,1]; conductor 1759607539536
E_Hm := EllipticCurve([1, 0, 0, -36695489711595793919114035740, -1707487024162878285827563481790502859156208]);
// rank in [1,1]; conductor 370617338014770

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![2582530071/100, 56229946813689/1000],
    E_ef![482345939469/19600, 100816781730972567/2744000],
    E_ef![-96477124877159/8156736, 1829011637059283207/23295638016]
];
gens_eg := [
    E_eg![-31490904631454242760/1842179138361, 4157639219946562167467026220/2500332636944096109]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![16426850, 21206053682]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 6216, +- 5687, +- 8425)
b_pt := V![0, 6216, 5687, 8425];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
