// Quadratic Chabauty Magma script for V_q at (m,n) = (86,47)
// Generated by gen_magma_script.gp
// q = 8084/5187
//   1 + q^2 = 9605^2 / 5187^2
// Total rank on J(V_q): [8,8]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 8 = 1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 5187 c, E = 5187 e, F = 5187 f, G = 5187 g:
//   E^2 = C^2 + 65351056
//   F^2 = C^2 + 26904969
//   G^2 = C^2 + 92256025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 65351056,
    F^2 - C^2 - 26904969,
    G^2 - C^2 - 92256025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -616883162049329, -5849980088779920900576]);
// rank in [3,3]; conductor 403027523456649
E_eg := EllipticCurve([1, 1, 1, -2024756996972695, -35061199050761852792380]);
// rank in [1,1]; conductor 100688513835
E_fg := EllipticCurve([0, 1, 0, -916356008402640, -10365613157797427731500]);
// rank in [1,1]; conductor 1611016221360
E_Hp := EllipticCurve([0, -1, 0, -1078789913802944, -4093211798435447894976]);
// rank in [2,2]; conductor 6448440375306384
E_Hm := EllipticCurve([1, 0, 0, -326497646090455602060664256590, 63789311062334777442745769285167463537586692]);
// rank in [1,1]; conductor 7742158725602227290

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![20179590096/25, 2865185558645604/125],
    E_ef![169683293136/3025, 61361626807583676/166375],
    E_ef![3140639739993/107584, 1126178131425704343/35287552]
];
gens_eg := [
];
gens_fg := [
    E_fg![352171289771971475/983637769, 208220566876570440838331400/30849831349147]
];
gens_Hp := [
    E_Hp![-8253376, 65178536904]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 8084, +- 5187, +- 9605)
b_pt := V![0, 8084, 5187, 9605];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
