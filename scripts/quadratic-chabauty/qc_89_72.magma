// Quadratic Chabauty Magma script for V_q at (m,n) = (89,72)
// Generated by gen_magma_script.gp
// q = 12816/2737
//   1 + q^2 = 13105^2 / 2737^2
// Total rank on J(V_q): [6,8]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 8 = 1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 2737 c, E = 2737 e, F = 2737 f, G = 2737 g:
//   E^2 = C^2 + 164249856
//   F^2 = C^2 + 7491169
//   G^2 = C^2 + 171741025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 164249856,
    F^2 - C^2 - 7491169,
    G^2 - C^2 - 171741025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -922084600464804, -2941912662925100933376]);
// rank in [3,3]; conductor 229111913054346
E_eg := EllipticCurve([1, 0, 0, -9403981992118020, -351006998060918025792000]);
// rank in [1,1]; conductor 19153717590
E_fg := EllipticCurve([0, -1, 0, -990888997419840, -2943908819802451289088]);
// rank in [0,2]; conductor 153229740720
E_Hp := EllipticCurve([0, -1, 0, -8601236459828544, -304784013886986204619776]);
// rank in [1,1]; conductor 1832895304434768
E_Hm := EllipticCurve([1, 0, 0, -15131302318485358475945897151240, 22654590733196116554714057229990551509676105792]);
// rank in [1,1]; conductor 3002511620577204330

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![54833856, 333691667232],
    E_ef![15191549646/25, 1870029732887904/125]
];
gens_eg := [
    E_eg![-616863831490371705195225/11018380533888676, 181999684251546308717412473930625/1156582590593599605600424]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![353393474, 6386691416546]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 12816, +- 2737, +- 13105)
b_pt := V![0, 12816, 2737, 13105];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
