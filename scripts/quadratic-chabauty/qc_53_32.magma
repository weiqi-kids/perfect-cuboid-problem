// Quadratic Chabauty Magma script for V_q at (m,n) = (53,32)
// Generated by gen_magma_script.gp
// q = 3392/1785
//   1 + q^2 = 3833^2 / 1785^2
// Total rank on J(V_q): [7,9]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1785 c, E = 1785 e, F = 1785 f, G = 1785 g:
//   E^2 = C^2 + 11505664
//   F^2 = C^2 + 3186225
//   G^2 = C^2 + 14691889
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 11505664,
    F^2 - C^2 - 3186225,
    G^2 - C^2 - 14691889
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -13661816952690, -18771188882462960508]);
// rank in [3,3]; conductor 1574121053190
E_eg := EllipticCurve([1, 1, 1, -56558146739570, -163708228982157096193]);
// rank in [2,2]; conductor 725241930
E_fg := EllipticCurve([0, 1, 0, -18361811011360, -28257212539106610700]);
// rank in [0,2]; conductor 5801935440
E_Hp := EllipticCurve([0, -1, 0, -35290899851040, -55375620352406085888]);
// rank in [2,2]; conductor 12592968425520
E_Hm := EllipticCurve([1, 0, 0, -339243329816292186714447780, 2353727928551406346751286414739191152400]);
// rank in [0,0]; conductor 6033605996877270

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-544245524/225, 1184519575906/3375],
    E_ef![-2304628, 689355830],
    E_ef![-523187961346884/220730449, 1783375173903524654094/3279392280793]
];
gens_eg := [
    E_eg![16297347, 56940750151],
    E_eg![2742984059457/259081, 2715521242896968879/131872229]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![35692754, 210134688850],
    E_Hp![1626411898021/47524, 2041233032437702875/10360232]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 3392, +- 1785, +- 3833)
b_pt := V![0, 3392, 1785, 3833];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
