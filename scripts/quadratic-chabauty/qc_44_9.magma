// Quadratic Chabauty Magma script for V_q at (m,n) = (44,9)
// Generated by gen_magma_script.gp
// q = 792/1855
//   1 + q^2 = 2017^2 / 1855^2
// Total rank on J(V_q): [6,8]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 8 = 1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1855 c, E = 1855 e, F = 1855 f, G = 1855 g:
//   E^2 = C^2 + 627264
//   F^2 = C^2 + 3441025
//   G^2 = C^2 + 4068289
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 627264,
    F^2 - C^2 - 3441025,
    G^2 - C^2 - 4068289
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -884419763640, -287947091944481508]);
// rank in [3,3]; conductor 344488759230
E_eg := EllipticCurve([1, 0, 0, -1097310682320, -379447872580657188]);
// rank in [1,1]; conductor 246941310
E_fg := EllipticCurve([0, -1, 0, -4674558471360, -3890042401186833408]);
// rank in [0,2]; conductor 1975530480
E_Hp := EllipticCurve([0, -1, 0, -3358560690240, -2060673269335769088]);
// rank in [2,2]; conductor 2755910073840
E_Hm := EllipticCurve([1, 0, 0, -2827021889545129012104480, 1822497905597167337785044444371174400]);
// rank in [0,0]; conductor 694833827366910

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-39778389/100, 30509482479/1000],
    E_ef![-35001803768291/63297936, 90261898705184988673/503598378816],
    E_ef![71849582308/2601, 19245989227299226/132651]
];
gens_eg := [
    E_eg![-3488860539/4624, 43405115822151/314432]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-901038, 483726654]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 792, +- 1855, +- 2017)
b_pt := V![0, 792, 1855, 2017];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
