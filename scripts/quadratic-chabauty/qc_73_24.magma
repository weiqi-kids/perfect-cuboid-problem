// Quadratic Chabauty Magma script for V_q at (m,n) = (73,24)
// Generated by gen_magma_script.gp
// q = 3504/4753
//   1 + q^2 = 5905^2 / 4753^2
// Total rank on J(V_q): [9,13]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 13 = -4

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 4753 c, E = 4753 e, F = 4753 f, G = 4753 g:
//   E^2 = C^2 + 12278016
//   F^2 = C^2 + 22591009
//   G^2 = C^2 + 34869025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 12278016,
    F^2 - C^2 - 22591009,
    G^2 - C^2 - 34869025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -94673377998924, -353919433762272635136]);
// rank in [3,3]; conductor 3067104744186
E_eg := EllipticCurve([1, 0, 0, -153339850777260, -719732586296951884800]);
// rank in [1,3]; conductor 1756158810
E_fg := EllipticCurve([0, -1, 0, -265716104134080, -1666373947999456969728]);
// rank in [1,1]; conductor 14049270480
E_Hp := EllipticCurve([0, -1, 0, -127910198192064, 83501181854697176064]);
// rank in [3,3]; conductor 24536837953488
E_Hm := EllipticCurve([1, 0, 0, -4296889542830417930548255320, 69513195990628448299367172717433334517312]);
// rank in [1,3]; conductor 18111253514418330

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![165941785735922/12623809, 1163275227623665811672/44852393377],
    E_ef![6849182848/81, 562873824313264/729],
    E_ef![276999061104/7225, 140527561829356872/614125]
];
gens_eg := [
    E_eg![-42541443885113161861730/5427805672891449, 319785349496311701796684269070120/399886217417979391378707]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![88658114, 828021224354],
    E_Hp![30793058, 159195207710]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 3504, +- 4753, +- 5905)
b_pt := V![0, 3504, 4753, 5905];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
