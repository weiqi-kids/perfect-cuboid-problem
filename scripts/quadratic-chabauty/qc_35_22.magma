// Quadratic Chabauty Magma script for V_q at (m,n) = (35,22)
// Generated by gen_magma_script.gp
// q = 1540/741
//   1 + q^2 = 1709^2 / 741^2
// Total rank on J(V_q): [8,8]
// Prime of good ordinary reduction: p = 29
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 8 = 1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 741 c, E = 741 e, F = 741 f, G = 741 g:
//   E^2 = C^2 + 2371600
//   F^2 = C^2 + 549081
//   G^2 = C^2 + 2920681
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 2371600,
    F^2 - C^2 - 549081,
    G^2 - C^2 - 2920681
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -503266322895, -129635145836242200]);
// rank in [3,3]; conductor 519937332915
E_eg := EllipticCurve([1, 1, 1, -2315176727045, -1355856993228325030]);
// rank in [2,2]; conductor 487552065
E_fg := EllipticCurve([0, 1, 0, -651740284720, -183502466642381932]);
// rank in [1,1]; conductor 7800833040
E_Hp := EllipticCurve([0, -1, 0, -1541258668320, -577748104016529600]);
// rank in [1,1]; conductor 8318997326640
E_Hm := EllipticCurve([1, 0, 0, -625625398106948726110890, 188523076118270266343659862273480100]);
// rank in [1,1]; conductor 1777145803903470

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![829976, 155801072],
    E_ef![2297112, 3290588376],
    E_ef![1776740, 2140376210]
];
gens_eg := [
    E_eg![17545418703/7396, 1621186192180193/636056],
    E_eg![180007003/36, 2286230162603/216]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![2171472, 2512880568]
];
gens_Hm := [
    E_Hm![-51880746736587888/58081, 2605425646458794290568262/13997521]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 1540, +- 741, +- 1709)
b_pt := V![0, 1540, 741, 1709];

// === Run QC ===
p := 29;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
