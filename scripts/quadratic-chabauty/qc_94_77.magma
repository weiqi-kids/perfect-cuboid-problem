// Quadratic Chabauty Magma script for V_q at (m,n) = (94,77)
// Generated by gen_magma_script.gp
// q = 14476/2907
//   1 + q^2 = 14765^2 / 2907^2
// Total rank on J(V_q): [7,9]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 2907 c, E = 2907 e, F = 2907 f, G = 2907 g:
//   E^2 = C^2 + 209554576
//   F^2 = C^2 + 8450649
//   G^2 = C^2 + 218005225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 209554576,
    F^2 - C^2 - 8450649,
    G^2 - C^2 - 218005225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -1432848836348719, -4093936369293480222496]);
// rank in [3,3]; conductor 705233463346797
E_eg := EllipticCurve([1, 1, 1, -15229485277480725, -723395730991164663588990]);
// rank in [1,1]; conductor 51778064415
E_fg := EllipticCurve([0, 1, 0, -1528951885599920, -3942015423301282267500]);
// rank in [1,1]; conductor 828449030640
E_Hp := EllipticCurve([0, -1, 0, -14071220540980384, -638793308050137681480896]);
// rank in [2,2]; conductor 11283735413548752
E_Hm := EllipticCurve([1, 0, 0, -40108984335615014644228284725450, 97770250482973872284114056266716454216737181732]);
// rank in [0,2]; conductor 20825544172630915410

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-271411243/16, 7924818858701/64],
    E_ef![56698827529/64, 13488254196663599/512],
    E_ef![78745715418449/160000, 696682250928764996657/64000000]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![274071370, 4011432491682],
    E_Hp![3729778866617/5776, 7071906422758171995/438976]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 14476, +- 2907, +- 14765)
b_pt := V![0, 14476, 2907, 14765];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
