// Quadratic Chabauty Magma script for V_q at (m,n) = (77,26)
// Generated by gen_magma_script.gp
// q = 4004/5253
//   1 + q^2 = 6605^2 / 5253^2
// Total rank on J(V_q): [6,10]
// Prime of good ordinary reduction: p = 19
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 5253 c, E = 5253 e, F = 5253 f, G = 5253 g:
//   E^2 = C^2 + 16032016
//   F^2 = C^2 + 27594009
//   G^2 = C^2 + 43626025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 16032016,
    F^2 - C^2 - 27594009,
    G^2 - C^2 - 43626025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -150247524641799, -708050565868109210136]);
// rank in [3,3]; conductor 60795884378229
E_eg := EllipticCurve([1, 1, 1, -249000821369885, -1492817660631724344910]);
// rank in [1,1]; conductor 34730761065
E_fg := EllipticCurve([0, 1, 0, -406627007516080, -3154216420729475176300]);
// rank in [0,2]; conductor 555692177040
E_Hp := EllipticCurve([0, -1, 0, -192022425308064, 282806949825855584064]);
// rank in [2,2]; conductor 972734150051664
E_Hm := EllipticCurve([1, 0, 0, -9377707754693999141750340570, 184559343435337756432202776546277800435812]);
// rank in [0,2]; conductor 803113632636405090

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-6201135629/900, 7403062966429/27000],
    E_ef![5788268221106136/56325025, 437065061556171101865576/422719312625],
    E_ef![-5181313322133481/736688164, 17580084950726569144991/19995190147288]
];
gens_eg := [
    E_eg![345801979343913/14432401, 4349953027466159098357/54828691399]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-11025456, 32552721864],
    E_Hp![1324485565/4, 48160601218431/8]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4004, +- 5253, +- 6605)
b_pt := V![0, 4004, 5253, 6605];

// === Run QC ===
p := 19;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
