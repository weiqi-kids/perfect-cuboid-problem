// Quadratic Chabauty Magma script for V_q at (m,n) = (95,34)
// Generated by gen_magma_script.gp
// q = 6460/7869
//   1 + q^2 = 10181^2 / 7869^2
// Total rank on J(V_q): [7,11]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 11 = -2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 7869 c, E = 7869 e, F = 7869 f, G = 7869 g:
//   E^2 = C^2 + 41731600
//   F^2 = C^2 + 61921161
//   G^2 = C^2 + 103652761
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 41731600,
    F^2 - C^2 - 61921161,
    G^2 - C^2 - 103652761
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -869848423574465, -9871317205561305501000]);
// rank in [3,3]; conductor 256577723647035
E_eg := EllipticCurve([1, 1, 1, -1521744982390615, -22646446450893051734020]);
// rank in [0,2]; conductor 129384576735
E_fg := EllipticCurve([0, 1, 0, -2175714901461840, -39025630647964351744812]);
// rank in [0,0]; conductor 2070153227760
E_Hp := EllipticCurve([0, -1, 0, -997229165253440, 6790532165057826369600]);
// rank in [3,3]; conductor 4105243578352560
E_Hm := EllipticCurve([1, 0, 0, -230350462020609939808965319630, 6716091343932754952239189806557194379600900]);
// rank in [1,3]; conductor 5224435608900926670

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![15140730588/169, 1745492552180922/2197],
    E_ef![629614861/16, 8302498416913/64],
    E_ef![16816903900/169, 2071247135467450/2197]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![32613130, 94634146450],
    E_Hp![1135071010, 38226753538190],
    E_Hp![80772677432120330/364008241, 22729579546571125609225950/6944913230039]
];
gens_Hm := [
    E_Hm![-58333853511213697765/376996, 1439143260997368329680423256605/231475544]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 6460, +- 7869, +- 10181)
b_pt := V![0, 6460, 7869, 10181];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
