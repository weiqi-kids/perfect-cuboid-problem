// Quadratic Chabauty Magma script for V_q at (m,n) = (63,38)
// Generated by gen_magma_script.gp
// q = 4788/2525
//   1 + q^2 = 5413^2 / 2525^2
// Total rank on J(V_q): [10,10]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 2525 c, E = 2525 e, F = 2525 f, G = 2525 g:
//   E^2 = C^2 + 22924944
//   F^2 = C^2 + 6375625
//   G^2 = C^2 + 29300569
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 22924944,
    F^2 - C^2 - 6375625,
    G^2 - C^2 - 29300569
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -54426114516745, -149326661877655991488]);
// rank in [3,3]; conductor 3334605031905
E_eg := EllipticCurve([1, 0, 0, -224751480208975, -1296824565825870679168]);
// rank in [1,1]; conductor 1090692435
E_fg := EllipticCurve([0, -1, 0, -73218835439440, -225137778544145612288]);
// rank in [1,1]; conductor 17451078960
E_Hp := EllipticCurve([0, -1, 0, -140013601817920, -435817780667752184768]);
// rank in [4,4]; conductor 53353680510480
E_Hm := EllipticCurve([1, 0, 0, -5343652737951011423545792190, 147088469266310969311366478538247305164100]);
// rank in [1,1]; conductor 36100434075403530

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-3801744259/784, 16617386054471/21952],
    E_ef![896449604/25, 26219493853582/125],
    E_ef![-9954307819/2704, 150630549616919/140608]
];
gens_eg := [
    E_eg![4149945852764/841, 8453928052111134922/24389]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![19693632, 66669084344],
    E_Hp![441210769, 9264283024500],
    E_Hp![-3918656, 7257616200],
    E_Hp![2918050254976/529, 4984689957571812600/12167]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4788, +- 2525, +- 5413)
b_pt := V![0, 4788, 2525, 5413];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
