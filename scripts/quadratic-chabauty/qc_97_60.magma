// Quadratic Chabauty Magma script for V_q at (m,n) = (97,60)
// Generated by gen_magma_script.gp
// q = 11640/5809
//   1 + q^2 = 13009^2 / 5809^2
// Total rank on J(V_q): [3,7]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 7 = 2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 5809 c, E = 5809 e, F = 5809 f, G = 5809 g:
//   E^2 = C^2 + 135489600
//   F^2 = C^2 + 33744481
//   G^2 = C^2 + 169234081
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 135489600,
    F^2 - C^2 - 33744481,
    G^2 - C^2 - 169234081
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -1739676853472620, -26629447050412337523700]);
// rank in [1,3]; conductor 35100384145890
E_eg := EllipticCurve([1, 0, 0, -7666875355310020, -258381686588656318947700]);
// rank in [0,2]; conductor 219906607710
E_fg := EllipticCurve([0, -1, 0, -2286018570872320, -38618899588463104409600]);
// rank in [1,1]; conductor 1759252861680
E_Hp := EllipticCurve([0, -1, 0, -4974698491073920, -101114931335727827225600]);
// rank in [1,1]; conductor 280803073167120
E_Hm := EllipticCurve([1, 0, 0, -6612260207435563451092452536840, 6454329958830161165911804540492854067030593600]);
// rank in [0,0]; conductor 456620897353883010

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-3514069794629265995431627/124685409381836944, 167207910532789899777363571918107413/44027441969308468571384128]
];
gens_eg := [
];
gens_fg := [
    E_fg![4070900943785/71824, 2268788889942388275/19248832]
];
gens_Hp := [
    E_Hp![121061440, 1034843896800]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 11640, +- 5809, +- 13009)
b_pt := V![0, 11640, 5809, 13009];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
