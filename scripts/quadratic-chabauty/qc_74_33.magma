// Quadratic Chabauty Magma script for V_q at (m,n) = (74,33)
// Generated by gen_magma_script.gp
// q = 4884/4387
//   1 + q^2 = 6565^2 / 4387^2
// Total rank on J(V_q): [8,8]
// Prime of good ordinary reduction: p = 17
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 8 = 1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 4387 c, E = 4387 e, F = 4387 f, G = 4387 g:
//   E^2 = C^2 + 23853456
//   F^2 = C^2 + 19245769
//   G^2 = C^2 + 43099225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 23853456,
    F^2 - C^2 - 19245769,
    G^2 - C^2 - 43099225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -153468342581929, -731752450052698390576]);
// rank in [3,3]; conductor 24681199823049
E_eg := EllipticCurve([1, 0, 0, -350405147898895, -2520620872679516129200]);
// rank in [2,2]; conductor 35165599755
E_fg := EllipticCurve([0, -1, 0, -288346479541840, -1874267929722508748288]);
// rank in [0,0]; conductor 562649596080
E_Hp := EllipticCurve([0, -1, 0, -160102961172544, 665031542765230709824]);
// rank in [2,2]; conductor 394899197168784
E_Hm := EllipticCurve([1, 0, 0, -5212287407844248187104060990, -71692691506215577142405260430816909547708]);
// rank in [1,1]; conductor 324064153676633370

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![260769421/16, 2118478513873/64],
    E_ef![37746370996/841, 7017154870361798/24389],
    E_ef![7310733202513/473344, 7855470309402653743/325660672]
];
gens_eg := [
    E_eg![-9522109327131106884944/886906471950625, 52174063360200832022614598614496/26412939468499764359375]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![4043904, 9149925064],
    E_Hp![-98339576/9, 899499386240/27]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4884, +- 4387, +- 6565)
b_pt := V![0, 4884, 4387, 6565];

// === Run QC ===
p := 17;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
