// Quadratic Chabauty Magma script for V_q at (m,n) = (64,53)
// Generated by gen_magma_script.gp
// q = 6784/1287
//   1 + q^2 = 6905^2 / 1287^2
// Total rank on J(V_q): [6,6]
// Prime of good ordinary reduction: p = 17
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 6 = 3

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1287 c, E = 1287 e, F = 1287 f, G = 1287 g:
//   E^2 = C^2 + 46022656
//   F^2 = C^2 + 1656369
//   G^2 = C^2 + 47679025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 46022656,
    F^2 - C^2 - 1656369,
    G^2 - C^2 - 47679025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -66417821527154, -25992170835453911676]);
// rank in [3,3]; conductor 2017512535038
E_eg := EllipticCurve([1, 1, 1, -731495612793970, -7614926408929317122305]);
// rank in [0,0]; conductor 313997970
E_fg := EllipticCurve([0, 1, 0, -70451454347040, -23359248844800511500]);
// rank in [0,0]; conductor 2511983760
E_Hp := EllipticCurve([0, -1, 0, -681532640954144, -6817225073298807480576]);
// rank in [2,2]; conductor 16140100280304
E_Hm := EllipticCurve([1, 0, 0, -93343331968010452309726367140, 10976669804814027283068266911182274987077392]);
// rank in [1,1]; conductor 13930924054437390

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-474776, 2331416602],
    E_ef![-4518452, 13487918686],
    E_ef![16624753536/1681, 1162060088078382/68921]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![61011794, 422745696594]
];
gens_Hm := [
    E_Hm![10514968682988987729895974355315016/246564659058291985009, 10297078279499553826895646646203063730232298165808124/3871651353952401276660782942473]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 6784, +- 1287, +- 6905)
b_pt := V![0, 6784, 1287, 6905];

// === Run QC ===
p := 17;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
