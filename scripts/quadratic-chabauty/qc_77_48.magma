// Quadratic Chabauty Magma script for V_q at (m,n) = (77,48)
// Generated by gen_magma_script.gp
// q = 7392/3625
//   1 + q^2 = 8233^2 / 3625^2
// Total rank on J(V_q): [7,7]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 7 = 2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 3625 c, E = 3625 e, F = 3625 f, G = 3625 g:
//   E^2 = C^2 + 54641664
//   F^2 = C^2 + 13140625
//   G^2 = C^2 + 67782289
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 54641664,
    F^2 - C^2 - 13140625,
    G^2 - C^2 - 67782289
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -275223876959990, -1667450881008241911708]);
// rank in [3,3]; conductor 2780154602610
E_eg := EllipticCurve([1, 0, 0, -1238176437425270, -16769093317685639423388]);
// rank in [2,2]; conductor 551528670
E_fg := EllipticCurve([0, -1, 0, -359102868894560, -2389917755254855166208]);
// rank in [1,1]; conductor 4412229360
E_Hp := EllipticCurve([0, -1, 0, -813453951359840, -6845124376116933650688]);
// rank in [1,1]; conductor 22241236820880
E_Hm := EllipticCurve([1, 0, 0, -175598521988724558166876324780, 27984584665791294609462359515236179347072400]);
// rank in [0,0]; conductor 22889012843288130

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![528357847804/25281, 166135767935936542/4019679],
    E_ef![-80966384/9, 242284953026/27],
    E_ef![-3950962176/361, 39903865764882/6859]
];
gens_eg := [
    E_eg![396940782076/9409, 71142397479449314/912673],
    E_eg![13856581606/225, 1265183703921634/3375]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![162687154, 2041243531250]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 7392, +- 3625, +- 8233)
b_pt := V![0, 7392, 3625, 8233];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
