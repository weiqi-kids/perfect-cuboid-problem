// Quadratic Chabauty Magma script for V_q at (m,n) = (37,26)
// Generated by gen_magma_script.gp
// q = 1924/693
//   1 + q^2 = 2045^2 / 693^2
// Total rank on J(V_q): [7,7]
// Prime of good ordinary reduction: p = 17
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 7 = 2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 693 c, E = 693 e, F = 693 f, G = 693 g:
//   E^2 = C^2 + 3701776
//   F^2 = C^2 + 480249
//   G^2 = C^2 + 4182025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 3701776,
    F^2 - C^2 - 480249,
    G^2 - C^2 - 4182025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -808804661819, -225125341058868096]);
// rank in [3,3]; conductor 357947086497
E_eg := EllipticCurve([1, 1, 1, -5165111573425, -4518212098042174690]);
// rank in [1,1]; conductor 227221995
E_fg := EllipticCurve([0, 1, 0, -954953307120, -272862498750360300]);
// rank in [1,1]; conductor 3635551920
E_Hp := EllipticCurve([0, -1, 0, -4052003477984, -2939605699147567296]);
// rank in [2,2]; conductor 5727153383952
E_Hm := EllipticCurve([1, 0, 0, -3847268985189607368702850, 2901713710909620070977879403855611332]);
// rank in [0,0]; conductor 1464003583772730

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![4091200267/1444, 246702882366017/54872],
    E_ef![1780067069548/1168561, 1819795634734645066/1263214441],
    E_ef![777276508/529, 16126291868738/12167]
];
gens_eg := [
];
gens_fg := [
    E_fg![97559706/25, 930629796096/125]
];
gens_Hp := [
    E_Hp![-1230416, 428120264],
    E_Hp![12675675824/121, 1426842168065496/1331]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 1924, +- 693, +- 2045)
b_pt := V![0, 1924, 693, 2045];

// === Run QC ===
p := 17;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
