// Quadratic Chabauty Magma script for V_q at (m,n) = (99,28)
// Generated by gen_magma_script.gp
// q = 5544/9017
//   1 + q^2 = 10585^2 / 9017^2
// Total rank on J(V_q): [9,11]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 11 = -2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 9017 c, E = 9017 e, F = 9017 f, G = 9017 g:
//   E^2 = C^2 + 30735936
//   F^2 = C^2 + 81306289
//   G^2 = C^2 + 112042225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 30735936,
    F^2 - C^2 - 81306289,
    G^2 - C^2 - 112042225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -886286644253514, -10038599072058161134656]);
// rank in [4,4]; conductor 210668707326462
E_eg := EllipticCurve([1, 0, 0, -1285630732110690, -17118244345470634548000]);
// rank in [2,2]; conductor 44095564590
E_fg := EllipticCurve([0, -1, 0, -3056260378721760, -65023932923994267595008]);
// rank in [1,3]; conductor 352764516720
E_Hp := EllipticCurve([0, -1, 0, -1685461832548704, -10854385900968766899456]);
// rank in [1,1]; conductor 1685349658611696
E_Hm := EllipticCurve([1, 0, 0, -798934373413071894873901458180, 253431216364774468941612284489290788382516752]);
// rank in [1,1]; conductor 2229928267050600270

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![758166810293/13456, 538177750662874261/1560896],
    E_ef![384807279/4, 7132756622421/8],
    E_ef![2260062957/16, 104829817463691/64],
    E_ef![12292351281/256, 987318939754287/4096]
];
gens_eg := [
    E_eg![1458435615/4, 55415570231385/8],
    E_eg![-4457796585631984/200364025, 61661648413522032494024/2836152773875]
];
gens_fg := [
    E_fg![-660722766623/20736, 8838261973652561/2985984]
];
gens_Hp := [
    E_Hp![-29443120, 115094337568]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 5544, +- 9017, +- 10585)
b_pt := V![0, 5544, 9017, 10585];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
