// Quadratic Chabauty Magma script for V_q at (m,n) = (89,80)
// Generated by gen_magma_script.gp
// q = 14240/1521
//   1 + q^2 = 14321^2 / 1521^2
// Total rank on J(V_q): [5,9]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1521 c, E = 1521 e, F = 1521 f, G = 1521 g:
//   E^2 = C^2 + 202777600
//   F^2 = C^2 + 2313441
//   G^2 = C^2 + 205091041
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 202777600,
    F^2 - C^2 - 2313441,
    G^2 - C^2 - 205091041
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -993577151315060, 5975704964711290194000]);
// rank in [3,3]; conductor 6958110958890
E_eg := EllipticCurve([1, 1, 1, -13862734525353460, -628234058581856653850635]);
// rank in [0,2]; conductor 497081910
E_fg := EllipticCurve([0, 1, 0, -1014796071447360, 6225937095677762579508]);
// rank in [1,1]; conductor 3976655280
E_Hp := EllipticCurve([0, -1, 0, -13551664352432960, -606937641841032127718400]);
// rank in [1,1]; conductor 55664887671120
E_Hm := EllipticCurve([1, 0, 0, -35219416219065557420324912537320, 80449123777832718329084837476716049530457678400]);
// rank in [0,2]; conductor 99647107042263690

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-8767887675380/303601, 17211771961225964660/167284151],
    E_ef![5614193245/1936, 4757098703784965/85184],
    E_ef![-11766350, 126644999350]
];
gens_eg := [
];
gens_fg := [
    E_fg![116391466/81, 50352275456000/729]
];
gens_Hp := [
    E_Hp![297217120, 4649822195200]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 14240, +- 1521, +- 14321)
b_pt := V![0, 14240, 1521, 14321];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
