// Quadratic Chabauty Magma script for V_q at (m,n) = (41,18)
// Generated by gen_magma_script.gp
// q = 1476/1357
//   1 + q^2 = 2005^2 / 1357^2
// Total rank on J(V_q): [9,9]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 9 = 0

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1357 c, E = 1357 e, F = 1357 f, G = 1357 g:
//   E^2 = C^2 + 2178576
//   F^2 = C^2 + 1841449
//   G^2 = C^2 + 4020025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 2178576,
    F^2 - C^2 - 1841449,
    G^2 - C^2 - 4020025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -1339613336669, -596778017640028896]);
// rank in [3,3]; conductor 56270204697
E_eg := EllipticCurve([1, 0, 0, -2989954461875, -1986299073712808400]);
// rank in [1,1]; conductor 334656555
E_fg := EllipticCurve([0, -1, 0, -2566436034320, -1574858344761581568]);
// rank in [1,1]; conductor 5354504880
E_Hp := EllipticCurve([0, -1, 0, -1375130403584, 563463148432931904]);
// rank in [2,2]; conductor 900323275152
E_Hm := EllipticCurve([1, 0, 0, -373557445656480836479750, -58488322160047176485015218755431068]);
// rank in [2,2]; conductor 225643520834970

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![9359524, 28398944242],
    E_ef![106954571629/10000, 34758984677354683/1000000],
    E_ef![2172874826852984464/8334777025, 3202833235326275519533157348/760923468497375]
];
gens_eg := [
];
gens_fg := [
    E_fg![-561070038942343447/574849043344, 7018168542764582240836947/435843646474900672]
];
gens_Hp := [
    E_Hp![10363114, 33154944626],
    E_Hp![117883352527210/104019601, 719966782299383294558/1060895910599]
];
gens_Hm := [
    E_Hm![5650506243370258030268321906324/199765402892415361, 13428547100894698565271454863032964759776444158/89285392733976006162259391]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 1476, +- 1357, +- 2005)
b_pt := V![0, 1476, 1357, 2005];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
