// Quadratic Chabauty Magma script for V_q at (m,n) = (71,50)
// Generated by gen_magma_script.gp
// q = 7100/2541
//   1 + q^2 = 7541^2 / 2541^2
// Total rank on J(V_q): [6,8]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 8 = 1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 2541 c, E = 2541 e, F = 2541 f, G = 2541 g:
//   E^2 = C^2 + 50410000
//   F^2 = C^2 + 6456681
//   G^2 = C^2 + 56866681
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 50410000,
    F^2 - C^2 - 6456681,
    G^2 - C^2 - 56866681
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -148741559968245, -558366779218310679600]);
// rank in [3,3]; conductor 3604391924595
E_eg := EllipticCurve([1, 1, 1, -956418311601995, -11384625395665418345080]);
// rank in [0,2]; conductor 618399705
E_fg := EllipticCurve([0, 1, 0, -175331008331920, -674882897452414018732]);
// rank in [1,1]; conductor 9894395280
E_Hp := EllipticCurve([0, -1, 0, -752458513441920, -7452288177435826545600]);
// rank in [1,1]; conductor 57670270793520
E_Hm := EllipticCurve([1, 0, 0, -132361149854210670190384955190, 18517732515757100912591903137968293356904100]);
// rank in [1,1]; conductor 54361439006741790

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-7683520, 11444296940],
    E_ef![-60246045795/8464, 9207636922840215/778688],
    E_ef![237413684075/676, 115606487658383695/17576]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![128655002, 1423113428242]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 7100, +- 2541, +- 7541)
b_pt := V![0, 7100, 2541, 7541];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
