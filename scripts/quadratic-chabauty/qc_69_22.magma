// Quadratic Chabauty Magma script for V_q at (m,n) = (69,22)
// Generated by gen_magma_script.gp
// q = 3036/4277
//   1 + q^2 = 5245^2 / 4277^2
// Total rank on J(V_q): [8,10]
// Prime of good ordinary reduction: p = 19
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 4277 c, E = 4277 e, F = 4277 f, G = 4277 g:
//   E^2 = C^2 + 9217296
//   F^2 = C^2 + 18292729
//   G^2 = C^2 + 27510025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 9217296,
    F^2 - C^2 - 18292729,
    G^2 - C^2 - 27510025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -57919071866459, -169172026260718740816]);
// rank in [3,3]; conductor 29461060848219
E_eg := EllipticCurve([1, 0, 0, -91494013094705, -330696948541566039000]);
// rank in [1,1]; conductor 17026544535
E_fg := EllipticCurve([0, -1, 0, -169514447068400, -849180419990115944448]);
// rank in [1,1]; conductor 272424712560
E_Hp := EllipticCurve([0, -1, 0, -83657660659424, 3955897716204005184]);
// rank in [3,3]; conductor 471376973571504
E_Hm := EllipticCurve([1, 0, 0, -1890874355932194616683732610, 23367551094296531121104125948628720824772]);
// rank in [0,2]; conductor 309046528297817310

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-159232757/36, 149673604361/216],
    E_ef![-41199417908/9409, 637832779258438/912673],
    E_ef![-11757699248/2601, 69893450473784/132651]
];
gens_eg := [
    E_eg![45751313224020669949/3843058378384, 123133785378672789971841642241/7533824039349398848]
];
gens_fg := [
    E_fg![136877048799597224319857/9100998202319104, 1573448865366955107788766332204535/868227510854766954999808]
];
gens_Hp := [
    E_Hp![-1154000, 9947865928],
    E_Hp![-2733136, 14566641336],
    E_Hp![-92076507914150/10042561, 15348573706168258402/31824875809]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 3036, +- 4277, +- 5245)
b_pt := V![0, 3036, 4277, 5245];

// === Run QC ===
p := 19;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
