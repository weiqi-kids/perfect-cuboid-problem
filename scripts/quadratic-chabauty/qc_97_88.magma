// Quadratic Chabauty Magma script for V_q at (m,n) = (97,88)
// Generated by gen_magma_script.gp
// q = 17072/1665
//   1 + q^2 = 17153^2 / 1665^2
// Total rank on J(V_q): [6,12]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 12 = -3

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 1665 c, E = 1665 e, F = 1665 f, G = 1665 g:
//   E^2 = C^2 + 291453184
//   F^2 = C^2 + 2772225
//   G^2 = C^2 + 294225409
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 291453184,
    F^2 - C^2 - 2772225,
    G^2 - C^2 - 294225409
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -2005505769528960, 19574684979447892905072]);
// rank in [3,3]; conductor 341905067410830
E_eg := EllipticCurve([1, 1, 1, -28584470864572640, -1860130236243716450236303]);
// rank in [0,2]; conductor 20315498610
E_fg := EllipticCurve([0, 1, 0, -2041572979482880, 20227418272692846936500]);
// rank in [0,2]; conductor 162523988880
E_Hp := EllipticCurve([0, -1, 0, -28048223297391360, -1807474826222081787691008]);
// rank in [2,2]; conductor 2735240539286640
E_Hm := EllipticCurve([1, 0, 0, -150312358454220302377791881104320, 709316618849680484924669134018819989469024358400]);
// rank in [1,3]; conductor 5864697621297966990

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![47293708782/289, 9915862353490068/4913],
    E_ef![259973690274/3721, 106576464651745668/226981],
    E_ef![9581711615178927/13060996, 936174326213087744274387/47202439544]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-96550878, 23484243006],
    E_Hp![856508798510264428289536/3899152352035249, 394910167663043551486153565753088000/243475522854540996110057]
];
gens_Hm := [
    E_Hm![386181220227794280410672376960/54446054865049, 846618089675041153634354060344723878104640/401744208457864364093]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 17072, +- 1665, +- 17153)
b_pt := V![0, 17072, 1665, 17153];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
