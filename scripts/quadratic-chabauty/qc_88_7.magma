// Quadratic Chabauty Magma script for V_q at (m,n) = (88,7)
// Generated by gen_magma_script.gp
// q = 1232/7695
//   1 + q^2 = 7793^2 / 7695^2
// Total rank on J(V_q): [6,12]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 12 = -3

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 7695 c, E = 7695 e, F = 7695 f, G = 7695 g:
//   E^2 = C^2 + 1517824
//   F^2 = C^2 + 59213025
//   G^2 = C^2 + 60730849
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 1517824,
    F^2 - C^2 - 59213025,
    G^2 - C^2 - 60730849
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -99306988036500, 31823083389223372032]);
// rank in [3,3]; conductor 2532242371890
E_eg := EllipticCurve([1, 1, 1, -103771711918580, 40091462792909856677]);
// rank in [0,2]; conductor 342034770
E_fg := EllipticCurve([0, 1, 0, -1198733755654720, -15974682108149423140300]);
// rank in [0,2]; conductor 2736278160
E_Hp := EllipticCurve([0, -1, 0, -1139537056296000, -14772435591988848411648]);
// rank in [1,3]; conductor 20257938975120
E_Hm := EllipticCurve([1, 0, 0, -255942548530864304587422599400, 49838069971614602406409566260140203408360000]);
// rank in [2,2]; conductor 19733764804138770

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![275268534, 4563912531408],
    E_ef![330846669/16, 5284571127387/64],
    E_ef![42813143808/2209, 7619451024581040/103823]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-19359166, 5716200350]
];
gens_Hm := [
    E_Hm![2306080336655882197200/7360369, 12695821378656024219091640938200/19968681097],
    E_Hm![209578717632718625323962109929645/206738772960846736, 2711665085108678573362000746432717132959048734125/94001092582705772219598016]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 1232, +- 7695, +- 7793)
b_pt := V![0, 1232, 7695, 7793];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
