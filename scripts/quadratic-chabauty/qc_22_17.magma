// Quadratic Chabauty Magma script for V_q at (m,n) = (22,17)
// Generated by gen_magma_script.gp
// q = 748/195
//   1 + q^2 = 773^2 / 195^2
// Total rank on J(V_q): [6,6]
// Prime of good ordinary reduction: p = 19
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 6 = 3

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 195 c, E = 195 e, F = 195 f, G = 195 g:
//   E^2 = C^2 + 559504
//   F^2 = C^2 + 38025
//   G^2 = C^2 + 597529
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 559504,
    F^2 - C^2 - 38025,
    G^2 - C^2 - 597529
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -12757137105, -282765147140448]);
// rank in [3,3]; conductor 19015731735
E_eg := EllipticCurve([1, 1, 1, -111470078135, -14324744121336988]);
// rank in [0,0]; conductor 28187445
E_fg := EllipticCurve([0, 1, 0, -14095445200, -304561999609900]);
// rank in [1,1]; conductor 450999120
E_Hp := EllipticCurve([0, -1, 0, -97738495680, -11565596118356928]);
// rank in [1,1]; conductor 304251707760
E_Hm := EllipticCurve([1, 0, 0, -2032217907292716551310, 35259172006468413700244926628100]);
// rank in [1,1]; conductor 29398321262310

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-294669/4, 128603619/8],
    E_ef![425312, 266669960],
    E_ef![-99168, 2712288]
];
gens_eg := [
];
gens_fg := [
    E_fg![-844491467953065905095/12027442220732416, 24285684187746560551348502297325/1319045932005288960065536]
];
gens_Hp := [
    E_Hp![-184726, 13626350]
];
gens_Hm := [
    E_Hm![380250286193880/529, 7400635295084420537130/12167]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 748, +- 195, +- 773)
b_pt := V![0, 748, 195, 773];

// === Run QC ===
p := 19;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
