// Quadratic Chabauty Magma script for V_q at (m,n) = (88,61)
// Generated by gen_magma_script.gp
// q = 10736/4023
//   1 + q^2 = 11465^2 / 4023^2
// Total rank on J(V_q): [7,7]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 7 = 2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 4023 c, E = 4023 e, F = 4023 f, G = 4023 g:
//   E^2 = C^2 + 115261696
//   F^2 = C^2 + 16184529
//   G^2 = C^2 + 131446225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 115261696,
    F^2 - C^2 - 16184529,
    G^2 - C^2 - 131446225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -826324691765934, -7588329075528327602316]);
// rank in [3,3]; conductor 8490545210994
E_eg := EllipticCurve([1, 1, 1, -5055695337494030, -138362294914162586563525]);
// rank in [1,1]; conductor 6877555410
E_fg := EllipticCurve([0, 1, 0, -985907966917600, -9362146266049266153100]);
// rank in [1,1]; conductor 55020443280
E_Hp := EllipticCurve([0, -1, 0, -3893913760749024, -86497037054815565558016]);
// rank in [1,1]; conductor 67924361687952
E_Hm := EllipticCurve([1, 0, 0, -3605974585387851797612360215260, 2632090177262926483161470893900744878748249872]);
// rank in [1,1]; conductor 97344100844046210

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-642603702/49, 10810280777442/343],
    E_ef![4582401418763403/60310756, 284209717440622733332581/468373331096],
    E_ef![328106991876/4225, 172934641414925454/274625]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![121404434, 1109120799346]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 10736, +- 4023, +- 11465)
b_pt := V![0, 10736, 4023, 11465];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
