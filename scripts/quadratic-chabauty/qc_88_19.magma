// Quadratic Chabauty Magma script for V_q at (m,n) = (88,19)
// Generated by gen_magma_script.gp
// q = 3344/7383
//   1 + q^2 = 8105^2 / 7383^2
// Total rank on J(V_q): [7,11]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 11 = -2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 7383 c, E = 7383 e, F = 7383 f, G = 7383 g:
//   E^2 = C^2 + 11182336
//   F^2 = C^2 + 54508689
//   G^2 = C^2 + 65691025
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 11182336,
    F^2 - C^2 - 54508689,
    G^2 - C^2 - 65691025
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -242285926445014, -1340274109368075038956]);
// rank in [3,3]; conductor 133709198035182
E_eg := EllipticCurve([1, 1, 1, -306759645755190, -1827106816971727354845]);
// rank in [0,2]; conductor 25012791870
E_fg := EllipticCurve([0, 1, 0, -1196182313905760, -15923453089601171887500]);
// rank in [1,1]; conductor 200102334960
E_Hp := EllipticCurve([0, -1, 0, -828902446532704, -7651328414703412173056]);
// rank in [2,4]; conductor 1069673584281456
E_Hm := EllipticCurve([1, 0, 0, -176502428054795816663583419180, 28363646825130342359980854931900056614500752]);
// rank in [1,1]; conductor 1083713050075150110

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-25831796929/2500, 969091231936981/125000],
    E_ef![179879842855502/5058001, 2128626612940676106406/11375444249],
    E_ef![41531631522034/1510441, 209882583563841227096/1856331989]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![839215999568/5929, 751663367217484800/456533]
];
gens_Hm := [
    E_Hm![3235767597962372558897709957750502936/449562486128965945129, 5810874061970328112886936899197065222692853139357086044/9532023324269697293245980147883]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 3344, +- 7383, +- 8105)
b_pt := V![0, 3344, 7383, 8105];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
