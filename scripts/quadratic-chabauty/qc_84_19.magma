// Quadratic Chabauty Magma script for V_q at (m,n) = (84,19)
// Generated by gen_magma_script.gp
// q = 3192/6695
//   1 + q^2 = 7417^2 / 6695^2
// Total rank on J(V_q): [6,10]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 6695 c, E = 6695 e, F = 6695 f, G = 6695 g:
//   E^2 = C^2 + 10188864
//   F^2 = C^2 + 44823025
//   G^2 = C^2 + 55011889
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 10188864,
    F^2 - C^2 - 44823025,
    G^2 - C^2 - 55011889
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -177222008351490, -854132015996552812608]);
// rank in [3,3]; conductor 185036814900210
E_eg := EllipticCurve([1, 0, 0, -228692542846170, -1201925596630463568288]);
// rank in [0,2]; conductor 39626138370
E_fg := EllipticCurve([0, -1, 0, -824095861764960, -9105517456862116555008]);
// rank in [0,2]; conductor 317009106960
E_Hp := EllipticCurve([0, -1, 0, -552073604655840, -3957503176466549906688]);
// rank in [1,1]; conductor 1480294519201680
E_Hm := EllipticCurve([1, 0, 0, -79972985758510505905781256180, 8622476952474747423704354086825684364576400]);
// rank in [2,2]; conductor 1372418056114857570

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![15279432, 2265801828],
    E_ef![13644561096/529, 1317846445939116/12167],
    E_ef![-374646413117066547/41090533264, 16182084839350313326137081/8329379816878912]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![41285904, 208860069600]
];
gens_Hm := [
    E_Hm![2690590491929417500/19881, 1478218232152418448866825320/2803221]
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 3192, +- 6695, +- 7417)
b_pt := V![0, 3192, 6695, 7417];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
