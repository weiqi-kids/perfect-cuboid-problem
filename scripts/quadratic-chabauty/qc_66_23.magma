// Quadratic Chabauty Magma script for V_q at (m,n) = (66,23)
// Generated by gen_magma_script.gp
// q = 3036/3827
//   1 + q^2 = 4885^2 / 3827^2
// Total rank on J(V_q): [6,10]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 3827 c, E = 3827 e, F = 3827 f, G = 3827 g:
//   E^2 = C^2 + 9217296
//   F^2 = C^2 + 14645929
//   G^2 = C^2 + 23863225
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 9217296,
    F^2 - C^2 - 14645929,
    G^2 - C^2 - 23863225
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -45612580434509, -118498524803242978416]);
// rank in [3,3]; conductor 15768512274669
E_eg := EllipticCurve([1, 0, 0, -77786953535555, -261276310602343951200]);
// rank in [1,3]; conductor 14189425305
E_fg := EllipticCurve([0, -1, 0, -118269669386000, -494691611503871029248]);
// rank in [0,2]; conductor 227030804880
E_Hp := EllipticCurve([0, -1, 0, -54821973012224, 67219850930603832384]);
// rank in [2,2]; conductor 252296196394704
E_Hm := EllipticCurve([1, 0, 0, -729285622166288744839350310, 2658376795164350298696657987843299961572]);
// rank in [0,0]; conductor 154058364923516130

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![69949939/4, 532500395891/8],
    E_ef![-93051408562673/23990404, 30555044796347491937/117504998792],
    E_ef![11160004623698887/157904356, 1173289107142957562371559/1984226137496]
];
gens_eg := [
    E_eg![2808950081760/32041, 4682724976426218000/5735339]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![426010, 6628910638]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 3036, +- 3827, +- 4885)
b_pt := V![0, 3036, 3827, 4885];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
