// Quadratic Chabauty Magma script for V_q at (m,n) = (93,26)
// Generated by gen_magma_script.gp
// q = 4836/7973
//   1 + q^2 = 9325^2 / 7973^2
// Total rank on J(V_q): [6,6]
// Prime of good ordinary reduction: p = 11
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 6 = 3

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 7973 c, E = 7973 e, F = 7973 f, G = 7973 g:
//   E^2 = C^2 + 23386896
//   F^2 = C^2 + 63568729
//   G^2 = C^2 + 86955625
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 23386896,
    F^2 - C^2 - 63568729,
    G^2 - C^2 - 86955625
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -529195495142559, -4625458424885189898216]);
// rank in [3,3]; conductor 387327033201381
E_eg := EllipticCurve([1, 0, 0, -762061205052405, -7794846797253314097600]);
// rank in [1,1]; conductor 17977400805
E_fg := EllipticCurve([0, -1, 0, -1853947580727600, -30721275606218598517248]);
// rank in [0,0]; conductor 287638412880
E_Hp := EllipticCurve([0, -1, 0, -1033751652405024, -5611807008513607962816]);
// rank in [2,2]; conductor 6197232531222096
E_Hm := EllipticCurve([1, 0, 0, -300385285216786305165883088010, 58959091421820788883883758712049526226158372]);
// rank in [0,0]; conductor 1444729833841151130

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![3412252457/64, 176399405864767/512],
    E_ef![23857184344/225, 3589646542775692/3375],
    E_ef![-6709189427652997610258892/466375187724722329, 1023523953299828443609534007472942642/318495393436218563668380733]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-22916080, 77739460552],
    E_Hp![-3354698215994104/115885225, 9211486336843980172256/1247504447125]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 4836, +- 7973, +- 9325)
b_pt := V![0, 4836, 7973, 9325];

// === Run QC ===
p := 11;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
