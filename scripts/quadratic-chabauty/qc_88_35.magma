// Quadratic Chabauty Magma script for V_q at (m,n) = (88,35)
// Generated by gen_magma_script.gp
// q = 6160/6519
//   1 + q^2 = 8969^2 / 6519^2
// Total rank on J(V_q): [10,10]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 10 = -1

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 6519 c, E = 6519 e, F = 6519 f, G = 6519 g:
//   E^2 = C^2 + 37945600
//   F^2 = C^2 + 42497361
//   G^2 = C^2 + 80442961
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 37945600,
    F^2 - C^2 - 42497361,
    G^2 - C^2 - 80442961
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -537960923191390, -4802565205544754983500]);
// rank in [3,3]; conductor 22848156068430
E_eg := EllipticCurve([1, 1, 1, -1055111008889790, -13136825392429479796245]);
// rank in [2,2]; conductor 45021061470
E_fg := EllipticCurve([0, 1, 0, -1169535112828640, -15361246373321792592012]);
// rank in [1,1]; conductor 360168491760
E_Hp := EllipticCurve([0, -1, 0, -544435463254240, 4681038068313777913600]);
// rank in [4,4]; conductor 182785248547440
E_Hm := EllipticCurve([1, 0, 0, -56968972021100673322719633980, -4381013374830911732760444269999712553455600]);
// rank in [0,0]; conductor 204925111777748670

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![-34841060150/2601, 13964400757400/132651],
    E_ef![25919773828/9, 4172810253009322/27],
    E_ef![3696166969/64, 202697616686609/512]
];
gens_eg := [
    E_eg![493309649203/12321, 128279863244983943/1367631],
    E_eg![35343087406767440245/28508296336, 210038999126499461339776928945/4813454786555584]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![16691472, 15618579328],
    E_Hp![233538960, 3551739445760],
    E_Hp![2691779600/169, 15559202910720/2197],
    E_Hp![815573130/49, 5205476411710/343]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 6160, +- 6519, +- 8969)
b_pt := V![0, 6160, 6519, 8969];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
