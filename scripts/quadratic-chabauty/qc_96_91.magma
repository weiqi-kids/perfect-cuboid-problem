// Quadratic Chabauty Magma script for V_q at (m,n) = (96,91)
// Generated by gen_magma_script.gp
// q = 17472/935
//   1 + q^2 = 17497^2 / 935^2
// Total rank on J(V_q): [5,7]
// Prime of good ordinary reduction: p = 19
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 7 = 2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 935 c, E = 935 e, F = 935 f, G = 935 g:
//   E^2 = C^2 + 305270784
//   F^2 = C^2 + 874225
//   G^2 = C^2 + 306145009
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 305270784,
    F^2 - C^2 - 874225,
    G^2 - C^2 - 306145009
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -2019318140610810, 29805645029156348895972]);
// rank in [3,3]; conductor 155397487335090
E_eg := EllipticCurve([1, 0, 0, -31152391560650490, -2116338845618605492839708]);
// rank in [0,2]; conductor 8932393470
E_fg := EllipticCurve([0, -1, 0, -2030676781080480, 30071462818953122940672]);
// rank in [1,1]; conductor 71459147760
E_Hp := EllipticCurve([0, -1, 0, -30974713494060960, -2098200581457991067236608]);
// rank in [1,1]; conductor 1243179898680720
E_Hm := EllipticCurve([1, 0, 0, -180923995097665439158927056676020, 936682415354254408760880022347068789140277216400]);
// rank in [0,0]; conductor 2718989835902069730

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![755564232, 20732170457910],
    E_ef![-49924816, 78655521338],
    E_ef![-240310694/9, 6867450180526/27]
];
gens_eg := [
];
gens_fg := [
];
gens_Hp := [
    E_Hp![477108242, 9577512330386]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 17472, +- 935, +- 17497)
b_pt := V![0, 17472, 935, 17497];

// === Run QC ===
p := 19;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
