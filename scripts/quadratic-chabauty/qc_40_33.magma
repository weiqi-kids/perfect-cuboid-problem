// Quadratic Chabauty Magma script for V_q at (m,n) = (40,33)
// Generated by gen_magma_script.gp
// q = 2640/511
//   1 + q^2 = 2689^2 / 511^2
// Total rank on J(V_q): [5,11]
// Prime of good ordinary reduction: p = 13
// QC margin: g + rho_NS - 1 - r_hi = 5 + 5 - 1 - 11 = -2

// Required: Magma 2.27+ with QCMod (Balakrishnan-Best-Bianchi 2021)
// Repo: https://github.com/jbalakrishnan/QCMod

SetVerbose("QCMod", 1);
AttachSpec("QCMod/spec");

// === Curve V_q in P^3 (intersection of 3 quadrics) ===
// With C = 511 c, E = 511 e, F = 511 f, G = 511 g:
//   E^2 = C^2 + 6969600
//   F^2 = C^2 + 261121
//   G^2 = C^2 + 7230721
P3<C, E, F, G> := ProjectiveSpace(Rationals(), 3);
V := Curve(P3, [
    E^2 - C^2 - 6969600,
    F^2 - C^2 - 261121,
    G^2 - C^2 - 7230721
]);
assert Genus(V) eq 5;

// === Five elliptic factors of J(V_q) ===
E_ef := EllipticCurve([1, 0, 0, -1544213192480, -110748956359885200]);
// rank in [3,3]; conductor 1131250813770
E_eg := EllipticCurve([1, 0, 0, -16799831530880, -26503639519103821200]);
// rank in [1,3]; conductor 453446070
E_fg := EllipticCurve([0, -1, 0, -1641350286080, -102697128624537600]);
// rank in [0,2]; conductor 3627568560
E_Hp := EllipticCurve([0, -1, 0, -15607866471680, -23616995026983321600]);
// rank in [1,1]; conductor 9050006510160
E_Hm := EllipticCurve([1, 0, 0, -49088639538502180036322560, 132378274411724131702731294165907865600]);
// rank in [0,2]; conductor 3041933438227530

// === Mordell-Weil generators (from PARI ellrank, effort=1) ===
gens_ef := [
    E_ef![501827032/81, 11008288251044/729],
    E_ef![4958586115/3844, 49695861610745/238328],
    E_ef![-1558826/9, 10512147874/27]
];
gens_eg := [
    E_eg![4996362, 3777141396]
];
gens_fg := [
];
gens_Hp := [
    E_Hp![-2253440, 333827200]
];
gens_Hm := [
];

MW := [* < E_ef, gens_ef >, < E_eg, gens_eg >, < E_fg, gens_fg >, < E_Hp, gens_Hp >, < E_Hm, gens_Hm > *];

// === Base point: a degenerate (c=0) point on V_q ===
// c=0 gives (E, F, G) = (+- 2640, +- 511, +- 2689)
b_pt := V![0, 2640, 511, 2689];

// === Run QC ===
p := 13;
N := 20;  // p-adic precision (increase to 25 for higher reliability; ~32GB RAM)

// QCModAffine is the Balakrishnan-Best-Bianchi 2021 driver
// candidates := QCModAffine(V, p, N : MWBasis := MW, BasePoint := b_pt);
// Print all candidate points (V(Q_p) cap V(Q-bar))
// printf "QC candidates: %o\n", candidates;

// Expected output for tractable cases (r_hi <= 8): finite set of size 8 (the c=0 degenerate points)
// If output size > 8: requires further sieving or beyond-QC method

quit;
