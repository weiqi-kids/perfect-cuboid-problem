Delta(Z) = Z^8 - 8*Z^7 + 12*Z^6 + 8*Z^5 - 26*Z^4 + 8*Z^3 + 12*Z^2 - 8*Z + 1

factor over Q[Z]:
[Z - 1, 4; Z + 1, 2; Z^2 - 6*Z + 1, 1]

G1(X, -q) = X^4 + 4*q*X^3 + (4*q^3 - 2*q^2 + 4*q)*X^2 + 4*q^3*X + q^4
G2(X,  q) = X^4 + 4*q*X^3 + (4*q^3 - 2*q^2 + 4*q)*X^2 + 4*q^3*X + q^4
G1(X, -q) - G2(X, q) = 0
