\\ Cumulative count by log10(N) bucket.
print("============================================================");
print("Rank-jump fiber growth (cumulative vs log10 N)");
print("============================================================");
print("log10 N | count rank>=1 | count rank=1 | count rank=2");
print("--------|---------------|--------------|-------------");

{
  buckets = [4, 5, 6, 7, 8, 9, 10];
  for(i = 1, #buckets,
    my(b = buckets[i], cnt = 0, cnt1 = 0, cnt2 = 0);
    for(j = 1, #all_jumps,
      if(all_jumps[j][2] <= 10^b,
        cnt = cnt + 1;
        if(all_jumps[j][3] == 1, cnt1 = cnt1 + 1);
        if(all_jumps[j][3] == 2, cnt2 = cnt2 + 1);
      );
    );
    print("  ", b, "    |     ", cnt, "         |   ", cnt1, "         |   ", cnt2);
  );
}

print();
print("Total rank-jump fibers found: ", #all_jumps);
print("  rank 1: ", sum(j=1, #all_jumps, if(all_jumps[j][3]==1, 1, 0)));
print("  rank 2: ", sum(j=1, #all_jumps, if(all_jumps[j][3]==2, 1, 0)));
print("  rank 3+: 0");
print();

print("============================================================");
print("Density: rank-jump per decade of log10 N");
print("============================================================");
print("decade [10^(k-1), 10^k] | count");
{
  for(k = 1, 10,
    my(lo = 10^(k-1), hi = 10^k, cnt = 0);
    for(j = 1, #all_jumps,
      if(all_jumps[j][2] > lo && all_jumps[j][2] <= hi, cnt = cnt + 1);
    );
    if(cnt > 0,
      print("  [10^", k-1, ", 10^", k, "]    ", cnt);
    );
  );
}

print();
print("===== End growth analysis =====");
quit;
