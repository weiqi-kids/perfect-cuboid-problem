  [56/783, 742922754, 1], [76/357, 825307959, 1],
  \\ 10^9<N<=10^10 (60 fibers)
  [155/468, 1178768955, 1], [44/483, 1229178489, 2], [152/345, 1257524310, 1], [656/1617, 1334710146, 1],
